DATABASE_URL="file:./dev.db"
PORT=3001
CORS_ORIGIN="http://localhost:5173"

# Required in production. Browser/user tokens may be scoped by device IDs.
ADMIN_API_TOKEN="change-me"
# API_TOKENS_JSON='{"viewer-token":{"role":"viewer","deviceIds":["esp32-001"]}}'

# Used only to authorize registration/provisioning; it is not a device event key.
DEVICE_REGISTRATION_TOKEN="change-me"

# Kept only on the server. Never returned by an API.
TRANSCRIPTION_API_KEY=""
FFMPEG_PATH="ffmpeg"

CALL_STORAGE_DIR="./storage/calls"
RECEIVER_SYNC_MS=2000
RECEIVER_LEASE_MS=15000
DEVICE_STREAM_TIMEOUT_MS=15000
DEVICE_HEALTH_TIMEOUT_MS=5000
