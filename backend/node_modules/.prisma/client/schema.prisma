generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Device {
  id                        String      @id
  label                     String?
  ip_address                String?
  active                    Boolean     @default(true)
  device_key_hash           String?
  firmware_events_supported Boolean     @default(false)
  audio_format              String      @default("pcm_s16le")
  audio_channels            Int         @default(1)
  input_sample_rate         Int?
  input_rate_source         String      @default("firmware")
  experimental_calibration  Boolean     @default(false)
  output_sample_rate        Int         @default(16000)
  audio_profile             String      @default("mild")
  receiver_status           String      @default("stopped")
  receiver_error            String?
  receiver_connected_at     DateTime?
  receiver_last_audio_at    DateTime?
  receiver_lease_owner      String?
  receiver_lease_until      DateTime?
  stream_session_id         String?
  health_json               String?
  created_at                DateTime    @default(now())
  updated_at                DateTime    @updatedAt
  deleted_at                DateTime?
  simcard                   Simcard?
  calls                     Call[]
  events                    CallEvent[]
}

model Simcard {
  iccid        String    @id
  phone_number String?
  ip_address   String?
  last_seen    DateTime?
  status       String    @default("offline")
  deviceId     String?   @unique
  device       Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  smss         Sms[]
  contacts     Contact[]
}

model Sms {
  id            Int      @id @default(autoincrement())
  simcardId     String
  sender_number String?
  message_text  String
  timestamp     DateTime
  direction     String
  simcard       Simcard  @relation(fields: [simcardId], references: [iccid])
}

model Contact {
  id         Int      @id @default(autoincrement())
  simcardId  String
  name       String
  phone      String
  fetched_at DateTime @default(now())
  simcard    Simcard  @relation(fields: [simcardId], references: [iccid], onDelete: Cascade)

  @@index([simcardId, name])
}

model Call {
  id                      String          @id @default(cuid())
  deviceId                String
  boot_id                 String
  external_call_id        String
  caller_number           String?
  sim_iccid_snapshot      String?
  sim_phone_snapshot      String?
  ringing_at              DateTime?
  answered_at             DateTime?
  ended_at                DateTime?
  duration_ms             Int?
  audio_duration_ms       Int?
  state                   String          @default("ringing")
  end_reason              String?
  boundary_mode           String          @default("event_received")
  recording_status        String          @default("waiting")
  processing_status       String          @default("waiting")
  transcription_status    String          @default("waiting")
  original_path           String?
  processed_path          String?
  audio_format            String          @default("pcm_s16le")
  input_sample_rate       Int?
  output_sample_rate      Int?
  sample_count            Int             @default(0)
  audio_bytes             Int             @default(0)
  audio_profile           String?
  quality_json            String?
  transcript              String?
  transcript_language     String?
  transcript_provider     String?
  transcript_model        String?
  processing_version      String?
  recording_error         String?
  processing_error        String?
  transcription_error     String?
  processing_attempts     Int             @default(0)
  transcription_attempts  Int             @default(0)
  recording_incomplete    Boolean         @default(false)
  missing_segments_json   String?
  answered_sample_counter String?
  ended_sample_counter    String?
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt
  device                  Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  events                  CallEvent[]
  jobs                    ProcessingJob[]

  @@unique([deviceId, boot_id, external_call_id])
  @@index([deviceId, created_at])
  @@index([state, created_at])
}

model CallEvent {
  id                  String   @id @default(cuid())
  deviceId            String
  callId              String?
  boot_id             String
  event_id            String
  external_call_id    String
  sequence            Int
  type                String
  reason              String?
  caller_number       String?
  sample_counter      String?
  device_monotonic_ms String?
  received_at         DateTime @default(now())
  payload_json        String?
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  call                Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@unique([deviceId, boot_id, event_id])
  @@unique([deviceId, boot_id, sequence])
  @@index([external_call_id])
}

model ProcessingJob {
  id           String    @id @default(cuid())
  callId       String
  type         String
  version      String    @default("1")
  status       String    @default("queued")
  attempts     Int       @default(0)
  max_attempts Int       @default(4)
  run_after    DateTime  @default(now())
  locked_by    String?
  locked_at    DateTime?
  last_error   String?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  call         Call      @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, type, version])
  @@index([status, run_after])
}

model ProviderConfig {
  id                       String   @id @default("default")
  base_url                 String   @default("https://api.openai.com/v1")
  model                    String   @default("whisper-1")
  language                 String?  @default("fa")
  response_format          String?  @default("json")
  supports_language        Boolean  @default(true)
  supports_response_format Boolean  @default(true)
  timeout_ms               Int      @default(120000)
  concurrency              Int      @default(2)
  max_file_bytes           Int      @default(25000000)
  chunk_overlap_ms         Int      @default(750)
  max_attempts             Int      @default(4)
  updated_at               DateTime @updatedAt
}

model RecordingPolicy {
  id                String   @id @default("default")
  pre_roll_ms       Int      @default(2000)
  max_call_bytes    Int      @default(536870912)
  retention_days    Int      @default(30)
  max_storage_bytes Int      @default(2000000000)
  delete_transcript Boolean  @default(false)
  updated_at        DateTime @updatedAt
}
